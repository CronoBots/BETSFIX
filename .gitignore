__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
*.log

# Données de suivi des prédictions (générées au runtime)
data/

# Fichiers runtime (PID de la boucle remote control, etc.)
.remote-control.pid

# Réglages locaux Claude Code (settings.local.json, locks) — MAIS on VERSIONNE
# .claude/settings.json : il porte le hook de clôture (rappel mémoire/CLAUDE.md) et doit
# survivre à un reclone, contrairement aux hooks git locaux. settings.local.json (permissions
# de cette machine) reste ignoré.
.claude/
!.claude/
.claude/*
!.claude/settings.json

# Brouillons d'images non référencés par l'app
static/logo.orig.png
static/sofascore.jpg
static/sofascore_banner.png
static/unibet.png
static/unibet_banner.png
